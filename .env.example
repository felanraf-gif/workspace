# API Tokens (wymagane)
TODOIST_API_TOKEN=your_todoist_api_token_here
GROQ_API_KEY=your_groq_api_key_here

# Obsidian (opcjonalne - używa domyślnej ścieżki jeśli puste)
OBSIDIAN_PATH=/home/felanraf/Dokumenty/Obsidian Vault/DevelopmentAssistant

# Todoist
TODOIST_PROJECT=Development Assistant Tasks

# LLM Provider: groq, openai, anthropic
LLM_PROVIDER=groq
LLM_MODEL=

# Konfiguracja (opcjonalne)
SCAN_INTERVAL=60
MAX_TASKS_PER_PROJECT=5
ENABLE_ANALYTICS=true
ENABLE_TRENDS=true
ENABLE_INTERACTION=true
ENABLE_LEARNING=true

# Bezpieczny tryb domyślny: analiza bez Buildera i trwałych zapisów.
OBSERVER_MODE=true

# R1: pass AUTHORIZED_REPO=/absolute/repository in the process launch environment.
# It is captured BEFORE .env is loaded. Missing/invalid = no persistent writes.
# Changing scope requires restarting the process with explicit authorization.
